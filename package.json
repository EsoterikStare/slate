{
  "name": "slate",
  "version": "0.1.0-alpha.4",
  "private": true,
  "description": "Custom Home Assistant cards for a portrait wall-mounted kiosk dashboard",
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "deploy:dev": "vite build && node scripts/deploy-dev.mjs"
  },
  "dependencies": {
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@bybas/weather-icons": "2.0.0",
    "@fontsource/roboto": "5.3.0",
    "@storybook/web-components-vite": "10.6.2",
    "happy-dom": "21.0.3",
    "storybook": "10.6.2",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
